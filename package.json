    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
